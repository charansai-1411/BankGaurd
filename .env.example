# BankGuard Environment Configuration Template

# 1. API Gateways and Ports
GATEWAY_PORT=8000
RBI_COMPLIANCE_PORT=8001
API_COMPLIANCE_PORT=8002
CODEBASE_PORT=8003

# 2. Supabase Settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-admin
SUPABASE_JWT_SECRET=your-supabase-jwt-signing-secret

# 3. Upstash Redis (For checkpointers and session memory)
REDIS_HOST=your-redis-host.upstash.io
REDIS_PORT=37910
REDIS_PASSWORD=your-redis-password
REDIS_SSL=true

# 4. Cloudflare R2 (S3-compatible storage for source code zip, raw pdfs, and reports)
R2_BUCKET_NAME=bankguard
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# 5. Gemini API Key
GEMINI_API_KEY=AIzaSy...
